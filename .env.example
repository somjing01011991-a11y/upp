# ที่อยู่ API server (ค่าเริ่มต้น http://127.0.0.1:7001/api) — รายชื่อค่ายโหลดจาก {VITE_API_SERVER}/member/gameprovider
# ใส่ค่าว่าง (VITE_API_SERVER=) เพื่อใช้ข้อมูลตัวอย่างใน src/data/sampleProviders.js
VITE_API_SERVER=http://127.0.0.1:7001/api
# URL ของ API รายชื่อเกมต่อค่าย ใช้ {provider} และ {type} เป็นตัวแทน เช่น https://api.example.com/games?provider={provider}&type={type}
VITE_GAMES_API=
